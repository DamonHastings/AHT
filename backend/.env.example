# Local dev only — the port the Express server listens on (ignored on Vercel,
# where the app runs as a serverless function).
PORT=5001

# Allowed browser origin(s) for CORS. Single value for dev; comma-separated
# list for production (apex + www so both resolve), no trailing slashes, e.g.
# CORS_ORIGIN=https://arielleraehastings.com,https://www.arielleraehastings.com
CORS_ORIGIN=http://localhost:5173

# Email delivery — REQUIRED for the contact / consultation / group-interest
# forms to actually reach the practitioner (submissions are emailed, not stored).
PRACTITIONER_EMAIL=you@example.com
# Either set MAILER_URL (e.g. smtps://user:pass@smtp.gmail.com:465) or the SMTP_* vars:
# MAILER_URL=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=noreply@yourdomain.com
